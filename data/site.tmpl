<!doctype html>
<title>Nathan Ogden</title>
<link rel="icon" type="image/png" href="i/f/32.png">
<meta name="viewport" content="width=device-width, initial-scale=1">

<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Courier+Prime:ital,wght@0,400;0,700;1,400;1,700&display=swap" rel="stylesheet">

<style>
    html, body { margin: 0; font-family: sans-serif; font-size: 1em; }
    a, a:hover, a:visited { color: #0c0b36; }
    .cl { clear: both; }
    #b { padding: 30px 30px 0; max-width: 1280px; margin: auto; }
    #h { height: 100px; position: relative; border-bottom: 8px solid; }
    #c { margin: 20px 15px 0 0; z-index: 2; text-align: right; position: absolute; right: 0; top: -10px; }
    #c b { margin: 0 8px 0 0; }
    #c img { margin: 10px 0 0 0; background: #000; border-radius: 32px; padding: 5px; max-width: 32px; }
    #l { font-family: "Courier Prime", courier, monospace; white-space: nowrap; font-size: 4em; margin-top: -20px; letter-spacing: -3px; text-shadow: 4px 4px 2px #8484845c; }
    #l f { letter-spacing: -10px; }
    #l i { color: #0c0b36; font-size: .6em; display: block; margin-top: -17px; letter-spacing: -3px; }
    h2 { font-size: 28px; margin: 40px 0 20px; letter-spacing: -1px; line-height: 25px; border-bottom: 4px solid; padding-bottom: 4px; text-shadow: 2px 2px 2px #8484845c; }
    h3 { margin: 0; border-bottom: 2px solid #fff; font-size: 22px; line-height: 40px; }
    p { line-height: 1.3em; }
    #abt { margin-top: 20px; font-size: 20px; line-height: 30px; padding: 20px; background: #0c0b36; color: #fff; }
    #abt p { line-height: 30px; padding: 0; margin: 0 }
    #tl .yr { margin-bottom: 5px; margin-top: 5px; font-style: italic; font-size: 30px; text-shadow: 3px 3px 2px #8484845c; }
    #tl .evt { border-left: 2px solid #000; margin-left: 30px; padding: 10px 16px; display: flex; }
    #tl .evt .r { flex: 33%; }
    #tl .evt .l { flex: 66%; margin-right: 20px; background: #0c0b36; color: #fff; padding: 15px; box-shadow: 4px 4px 2px #8484845c; }
    #tl .evt .l a { color: #fff; }
    #tl .evt img { width: 100%; box-shadow: 4px 4px 2px #8484845c; }
    #tl .evt a { display: block; }
    #tl .evt.t-event .l { background: none; color: #000; box-shadow: none; border-bottom: none; }
    #sp .spl { columns: 3; }
    #sp .spl .proj { break-inside: avoid;  background: #0c0b36; color: #fff; padding: 25px 20px; margin-bottom: 10px;  box-shadow: 4px 4px 2px #8484845c; }
    #sp .spl .proj a { color: #fff; display: inline-block; margin-bottom: 5px; }
    #sp .spl .proj h3 { font-size: 20px; line-height: 22px; padding-bottom: 10px; }
    footer { background: #000; color: #fff; text-align: center; padding: 10px; box-shadow: -31px 0px 0px #000, 31px 0px 0px #000; margin-top: 15px; }

    @media (max-width: 720px) {
        #h { height: auto; }
        #l { text-align: center; }
        #c { position: static; text-align: center; margin: 25px 0 20px 0; }
        .p { width: 100%; margin-right: 0; }
    }
    @media (max-width: 475px) {
        #l { font-size: 3em; }
        #l i { margin-top: -12px; }
    }
    @media (max-width: 360px) {
        #l { font-size: 2.5em; }
    }
</style>
<div id=b>
    <div id=h>
        <div id=l><b>N<f>at</f>han Ogden</b><i>software engineer</i></div>
        <div id=c>
            <b>Email:</b><a href="mailto:{{ .Info.Email }}">{{ .Info.Email }}</a><br>
            <a href="{{ .Info.Github }}"><img src="i/github.png" alt="Github" /></a>
            <a href="{{ .Info.LinkedIn }}"><img src="i/linkedin.png" alt="LinkedIn" /></a>
        </div>
    </div>
  
    <div id=abt>{{ (Markdown .Info.About) }}</div>

    <div id=tl>
    <h2>Professional Timeline</h2>
    {{ range $year := .EventYears }}
        <div class=yr>{{ $year }}</div>

        {{ range $event := $.Events }}
        {{ if eq $event.Year $year }}
            <div class="evt t-{{ $event.Type }}">
                <div class=l>
                    <h3>{{ $event.Name }}</h3><p>{{ Markdown $event.Description }}</p>
                </div>
                {{ if $event.Images }}
                <div class=r>
                    <img src="{{ index $event.Images 0 }}" />
                </div>
                {{ end }}
            </div>
        {{ end }}
        {{ end }}

    {{ end }}

    <div id=sp>
    <h2>Side Projects</h2>

    <div class=spl>
    {{ range $project := $.SideProjects }}
    <div class=proj>
        <h3>{{ $project.Name }}</h3>
        <p>{{ Markdown $project.Description }}</p>
    </div>
    {{ end }}
    </div>

    </div>

    </div>
    <footer>Copyright &copy; {{ .CopyrightYear }} Nathan Ogden</footer>
</div>